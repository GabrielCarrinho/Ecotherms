<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6EDE9">

 <!-- Cabeçalho -->
 <FrameLayout
     android:id="@+id/topBar"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:paddingStart="20dp"
     android:paddingEnd="20dp"
     android:paddingTop="20dp"
     app:layout_constraintTop_toTopOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <ImageButton
      android:id="@+id/btn_back"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_gravity="start|center_vertical"
      android:background="@drawable/bg_circle_light_gray"
      android:src="@drawable/ic_arrow_back"
      app:tint="#1E3A29"
      android:padding="12dp"
      android:contentDescription="Voltar" />

 </FrameLayout>

 <!-- Título -->
 <LinearLayout
     android:id="@+id/headerLayout"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:orientation="vertical"
     android:paddingStart="20dp"
     android:paddingEnd="20dp"
     android:paddingTop="12dp"
     app:layout_constraintTop_toBottomOf="@id/topBar"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <TextView
      android:id="@+id/tvTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Histórico de Plantas"
      android:textColor="#1E3A29"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium"
      android:textSize="30sp"/>

  <TextView
      android:id="@+id/tvSubtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Suas plantas salvas"
      android:textColor="#7A8C82"
      android:textSize="15sp"/>
 </LinearLayout>

 <!-- Card contador -->
 <androidx.cardview.widget.CardView
     android:id="@+id/cardCounter"
     android:layout_width="0dp"
     android:layout_height="wrap_content"
     android:layout_marginHorizontal="20dp"
     android:layout_marginTop="18dp"
     app:cardCornerRadius="22dp"
     app:cardElevation="0dp"
     app:cardBackgroundColor="#1E3A29"
     app:layout_constraintTop_toBottomOf="@id/headerLayout"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="20dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">

   <FrameLayout
       android:layout_width="52dp"
       android:layout_height="52dp"
       android:background="@drawable/bg_circle_counter_icon">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_plant"/>
   </FrameLayout>

   <LinearLayout
       android:layout_width="0dp"
       android:layout_weight="1"
       android:layout_height="wrap_content"
       android:layout_marginStart="16dp"
       android:orientation="vertical">

    <TextView
        android:id="@+id/tvPlantCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="plantas registradas"
        android:textColor="#A8D5B2"
        android:textSize="13sp"/>
   </LinearLayout>

   <ImageButton
       android:id="@+id/btn_add_from_counter"
       android:layout_width="42dp"
       android:layout_height="42dp"
       android:background="@drawable/bg_circle_accent"
       android:src="@drawable/ic_camera"
       app:tint="#FFFFFF"
       android:padding="10dp"
       android:contentDescription="Identificar nova planta" />

  </LinearLayout>

 </androidx.cardview.widget.CardView>

 <!-- Estado vazio -->
 <LinearLayout
     android:id="@+id/emptyState"
     android:layout_width="0dp"
     android:layout_height="0dp"
     android:orientation="vertical"
     android:gravity="center"
     android:visibility="gone"
     android:paddingStart="40dp"
     android:paddingEnd="40dp"
     app:layout_constraintTop_toBottomOf="@id/cardCounter"
     app:layout_constraintBottom_toBottomOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent">

  <FrameLayout
      android:layout_width="96dp"
      android:layout_height="96dp"
      android:background="@drawable/bg_circle_empty_state">

   <ImageView
       android:layout_width="44dp"
       android:layout_height="44dp"
       android:layout_gravity="center"
       android:src="@drawable/ic_plant"
       app:tint="#A8D5B2"/>
  </FrameLayout>

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:text="Nenhuma planta salva ainda"
      android:textStyle="bold"
      android:fontFamily="sans-serif-medium"
      android:textSize="19sp"
      android:textColor="#1E3A29"/>

  <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Identifique uma planta no scanner e toque em salvar — ela aparece aqui."
      android:textColor="#7A8C82"
      android:textSize="14sp"
      android:textAlignment="center"
      android:lineSpacingExtra="2dp"/>

  <Button
      android:id="@+id/btnGoToScanner"
      android:layout_width="wrap_content"
      android:layout_height="52dp"
      android:layout_marginTop="24dp"
      android:background="@drawable/bg_btn_ver_perfil"
      android:text="Identificar planta"
      android:textAllCaps="false"
      android:textStyle="bold"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:drawableStart="@drawable/ic_camera"
      android:drawablePadding="8dp"
      app:drawableTint="#FFFFFF"/>

 </LinearLayout>

 <!-- Lista de plantas -->
 <androidx.recyclerview.widget.RecyclerView
     android:id="@+id/rvPlants"
     android:layout_width="0dp"
     android:layout_height="0dp"
     android:layout_marginTop="16dp"
     android:paddingHorizontal="20dp"
     android:clipToPadding="false"
     android:paddingBottom="20dp"
     app:layout_constraintTop_toBottomOf="@id/cardCounter"
     app:layout_constraintBottom_toBottomOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
