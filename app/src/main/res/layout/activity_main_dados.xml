<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/texto_claro">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/header_top_padding"
                android:paddingBottom="8dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu_hamburguer"
                    app:tint="@color/verde_escuro"
                    android:padding="6dp"
                    android:contentDescription="Menu" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:scaleType="fitStart"
                    android:src="@drawable/wordmark_ecotherms"
                    android:contentDescription="ecotherms" />

                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/verde_escuro"
                    android:padding="7dp"
                    android:contentDescription="Notificações" />
            </LinearLayout>

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisoria"
                android:layout_marginBottom="20dp" />

            <!-- Card título -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_destaque"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GRÁFICO DOS DADOS APRESENTADOS"
                        android:textColor="@color/texto_claro"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />

                    <TextView
                        android:id="@+id/tvGreenhouseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Estufa casa de plantas"
                        android:textColor="@color/texto_claro"
                        android:textSize="@dimen/title_text_size"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvLastUpdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Última atualização: agora mesmo"
                        android:textColor="@color/texto_claro"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Seletor de métrica -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECIONAR DADO"
                android:textColor="@color/texto"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="10dp" />

            <!-- Linha 1: Temp. Ar e Umidade Ar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipTemperatura"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Temp. Ar"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/background_button_enabled"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/chipUmidade"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Umid. Ar"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/background_button_disabled"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Linha 2: Umid. Solo e Temp. Solo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipUmidadeSolo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Umid. Solo"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/background_button_disabled"
                    android:padding="6dp" />

                <TextView
                    android:id="@+id/chipTemperaturaSolo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text=" Temp. Solo"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/background_button_disabled"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Linha 3: Irrigação centralizada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/chipIrrigacao"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Irrigação"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/texto_claro"
                    android:background="@drawable/background_button_disabled"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Período -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERÍODO DE EXIBIÇÃO"
                android:textColor="@color/texto"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btn1h"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="1H"
                    android:textColor="@color/texto_claro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/botao" />

                <Button
                    android:id="@+id/btn6h"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="6H"
                    android:textColor="@color/texto_claro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/texto_secundario" />

                <Button
                    android:id="@+id/btn24h"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="24H"
                    android:textColor="@color/texto_claro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/texto_secundario" />

                <Button
                    android:id="@+id/btn7d"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="7D"
                    android:textColor="@color/texto_claro"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/texto_secundario" />
            </LinearLayout>

            <!-- Card do gráfico -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Título dinâmico do gráfico -->
                    <TextView
                        android:id="@+id/tvTituloGrafico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperatura do Ar (°C)"
                        android:textColor="@color/texto"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Valores min/atual/max -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÍN"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvMin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/texto"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ATUAL"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAtual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/divisoria"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÁX"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/texto"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartGeral"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_height" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botão atualizar -->
            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="ATUALIZAR DADOS"
                android:textColor="@color/texto_claro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:backgroundTint="@color/botao"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ecotherms - Monitoramento de Estufas \n TCC - 2026"
                android:textColor="@color/texto_secundario"
                android:textSize="10sp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:background="@color/nav_bar"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_home_novo"
                android:contentDescription="Home"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Início"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navChart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_grafico_novo"
                android:contentDescription="Gráfico"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Gráficos"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_scanner_novo"
                android:contentDescription="Cadastro"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Scanner"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_person"
                android:contentDescription="Perfil"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Perfil"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>


</LinearLayout>

    <!-- Painel do menu lateral -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/cinza_claro"
        android:paddingTop="36dp"
        android:fitsSystemWindows="true">

        <!-- Cabeçalho do menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/logo_ecotherms"
                android:contentDescription="Logo Ecotherms" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:scaleType="fitStart"
                android:src="@drawable/wordmark_ecotherms"
                android:contentDescription="ecotherms" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8E0D4"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Itens do menu -->
        <LinearLayout
            android:id="@+id/drawerItemHistory"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_plant" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Histórico de Plantas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemProfile"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_person" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Meu Perfil" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemPreferences"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_notification" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Preferências" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemSettings"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_settings" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Configurações" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8E0D4"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/drawerItemLogout"
            style="@style/DrawerMenuItem"
            android:layout_marginBottom="20dp">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_logout" android:tint="#C0392B" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Sair" android:textColor="#C0392B" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>