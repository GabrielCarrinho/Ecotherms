<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/texto_claro">

    <!-- Conteúdo da tela de resultado -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/header_top_padding"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="@dimen/header_logo_size"
                    android:layout_height="@dimen/header_logo_size"
                    android:src="@drawable/logo_ecotherms"
                    android:contentDescription="Logo Ecotherms" />

                <ImageView
                    android:layout_width="@dimen/header_wordmark_width"
                    android:layout_height="@dimen/header_wordmark_height"
                    android:layout_marginStart="10dp"
                    android:contentDescription="Logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nome_ecotherms" />

            </LinearLayout>

            <!-- Divisória -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divisoria"
                android:layout_marginBottom="16dp" />

            <!-- Foto capturada -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="@dimen/plant_photo_height"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/ivPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Foto da planta" />

            </androidx.cardview.widget.CardView>

            <!-- Card com os dados -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESULTADO DA IDENTIFICAÇÃO"
                        android:textColor="@color/texto"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome científico"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvScientific"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/texto"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome popular"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvCommon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/texto"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Probabilidade de ser"
                        android:textColor="@color/texto_secundario"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvScore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/texto"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/btnSaveHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="18dp"
        android:background="@drawable/bg_button_olive_light"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_save"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Salvar no Histórico"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Nav bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:orientation="horizontal"
        android:background="@color/nav_bar"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_home_novo"
                android:contentDescription="Home"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Início"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navChart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_grafico_novo"
                android:contentDescription="Gráfico"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Gráficos"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_scanner_novo"
                android:contentDescription="Scanner"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Scanner"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
                android:layout_width="@dimen/bottom_nav_icon"
                android:layout_height="@dimen/bottom_nav_icon"
                android:src="@drawable/ic_person"
                android:contentDescription="Perfil"
                app:tint="@color/texto_claro" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Perfil"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>