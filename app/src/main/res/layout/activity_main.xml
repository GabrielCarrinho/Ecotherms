<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    android:id="@+id/drawerLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/cinza_claro">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- cabeçalho -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/header_top_padding"
                    android:paddingBottom="8dp">

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_menu_hamburguer"
                        app:tint="@color/verde_escuro"
                        android:padding="6dp"
                        android:contentDescription="Menu" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:scaleType="fitStart"
                        android:src="@drawable/wordmark_ecotherms"
                        android:contentDescription="ecotherms" />

                    <ImageButton
                        android:id="@+id/btnNotifications"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/verde_escuro"
                        android:padding="7dp"
                        android:contentDescription="Notificações" />
                </LinearLayout>

                <!-- divisoria -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divisoria"
                    android:layout_marginBottom="20dp" />

                <!-- card título estufa -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/card_destaque"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/screen_padding"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTUFA MONITORADA"
                            android:textColor="@color/branco"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.2" />

                        <TextView
                            android:id="@+id/tvGreenhouseName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Estufa casa de plantas"
                            android:textColor="@color/branco"
                            android:textSize="@dimen/title_text_size"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvLastUpdate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Última atualização: agora mesmo"
                            android:textColor="@color/texto_claro"
                            android:textSize="11sp" />

                        <LinearLayout
                            android:id="@+id/layoutConnectionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Conectado"
                                android:textColor="@color/branco"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Ambiente + Ciclo (antigos cards "DADOS EXTRAS", agora só os ícones aqui) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="18dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_ambiente_novo"
                                    app:tint="@color/texto_claro"
                                    android:contentDescription="Ambiente"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvEnvironmentStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="Ótimo"
                                    android:textColor="@color/texto_claro"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_ciclo_novo"
                                    app:tint="@color/texto_claro"
                                    android:contentDescription="Ciclo"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvCycleStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="Dia"
                                    android:textColor="@color/texto_claro"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- status -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS DA ESTUFA"
                    android:textColor="@color/texto"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="12dp" />

                <!-- card temperatura -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="3dp"
                            android:background="@color/divisoria"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="Temperatura"
                                android:textColor="@color/texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTemperatureValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="28°C"
                                android:textColor="@color/texto"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:fontFamily="sans-serif-condensed" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <ImageView
                                    android:id="@+id/ivTemperatureAlert"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_alerta_novo"
                                    app:tint="#C0392B"
                                    android:visibility="gone"
                                    android:contentDescription="Fora da faixa ideal"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvTemperatureStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Normal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressTemperature"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progress="31"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_temperature" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0°C"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="90°C"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Umidade do Ar -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="3dp"
                            android:background="@color/divisoria"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="Umidade"
                                android:textColor="@color/texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHumidityValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="65%"
                                android:textColor="@color/texto"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:fontFamily="sans-serif-condensed" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <ImageView
                                    android:id="@+id/ivHumidityAlert"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_alerta_novo"
                                    app:tint="#C0392B"
                                    android:visibility="gone"
                                    android:contentDescription="Fora da faixa ideal"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvHumidityStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ideal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressHumidity"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progress="65"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_humidity" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="100%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Umidade do Solo -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="3dp"
                            android:background="@color/divisoria"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="Umidade do solo"
                                android:textColor="@color/texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSoilHumidityValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="45%"
                                android:textColor="@color/texto"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:fontFamily="sans-serif-condensed" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <ImageView
                                    android:id="@+id/ivSoilHumidityAlert"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_alerta_novo"
                                    app:tint="#C0392B"
                                    android:visibility="gone"
                                    android:contentDescription="Fora da faixa ideal"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvSoilHumidityStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ideal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressSoilHumidity"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progress="45"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_humidity" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="100%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Temperatura do Solo -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="3dp"
                            android:background="@color/divisoria"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="Temperatura do solo"
                                android:textColor="@color/texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSoilTemperatureValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="22°C"
                                android:textColor="@color/texto"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:fontFamily="sans-serif-condensed" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <ImageView
                                    android:id="@+id/ivSoilTemperatureAlert"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_alerta_novo"
                                    app:tint="#C0392B"
                                    android:visibility="gone"
                                    android:contentDescription="Fora da faixa ideal"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvSoilTemperatureStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Normal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressSoilTemperature"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progress="24"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_temperature" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0°C"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="90°C"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card Irrigação -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <View
                            android:layout_width="32dp"
                            android:layout_height="3dp"
                            android:background="@color/divisoria"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.5"
                                android:text="Irrigação"
                                android:textColor="@color/texto"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvIrrigationValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="40%"
                                android:textColor="@color/texto"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:fontFamily="sans-serif-condensed" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical|end">

                                <ImageView
                                    android:id="@+id/ivIrrigationAlert"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/ic_alerta_novo"
                                    app:tint="#C0392B"
                                    android:visibility="gone"
                                    android:contentDescription="Fora da faixa ideal"
                                    tools:ignore="UseAppTint" />

                                <TextView
                                    android:id="@+id/tvIrrigationStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Normal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressIrrigation"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progress="40"
                            android:max="100"
                            android:progressDrawable="@drawable/progress_humidity" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="100%"
                                android:textColor="@color/texto_secundario"
                                android:textSize="9sp"
                                android:gravity="end" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botão atualizar -->
                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="ATUALIZAR DADOS"
                    android:textColor="@color/texto_claro"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="@drawable/bg_button_atualizar"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="8dp" />

                <!-- Rodapé -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ecotherms - Monitoramento de Estufas \n TCC - 2026"
                    android:textColor="@color/texto_secundario"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="20dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Barra de navegação -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:orientation="horizontal"
            android:background="@color/nav_bar"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/bottom_nav_icon"
                    android:layout_height="@dimen/bottom_nav_icon"
                    android:src="@drawable/ic_home_novo"
                    android:contentDescription="Home"
                    app:tint="@color/texto_claro"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Início"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navChart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/bottom_nav_icon"
                    android:layout_height="@dimen/bottom_nav_icon"
                    android:src="@drawable/ic_grafico_novo"
                    android:contentDescription="Gráfico"
                    app:tint="@color/texto_claro"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Gráficos"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navPlants"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/bottom_nav_icon"
                    android:layout_height="@dimen/bottom_nav_icon"
                    android:src="@drawable/ic_scanner_novo"
                    android:contentDescription="Cadastro de plantas"
                    app:tint="@color/texto_claro"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Scanner"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/bottom_nav_icon"
                    android:layout_height="@dimen/bottom_nav_icon"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Perfil"
                    app:tint="@color/texto_claro"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Perfil"
                    android:textColor="@color/texto_claro"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <!-- Painel do menu lateral -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/cinza_claro"
        android:paddingTop="36dp"
        android:fitsSystemWindows="true">

        <!-- Cabeçalho do menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/logo_ecotherms"
                android:contentDescription="Logo Ecotherms" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:scaleType="fitStart"
                android:src="@drawable/wordmark_ecotherms"
                android:contentDescription="ecotherms" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8E0D4"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Itens do menu -->
        <LinearLayout
            android:id="@+id/drawerItemHistory"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_plant" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Histórico de Plantas" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemProfile"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_person" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Meu Perfil" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemPreferences"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_notification" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Preferências" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerItemSettings"
            style="@style/DrawerMenuItem">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_settings" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Configurações" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8E0D4"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/drawerItemLogout"
            style="@style/DrawerMenuItem"
            android:layout_marginBottom="20dp">

            <FrameLayout style="@style/DrawerMenuIconBg">
                <ImageView style="@style/DrawerMenuIcon" android:src="@drawable/ic_logout" android:tint="#C0392B" />
            </FrameLayout>

            <TextView style="@style/DrawerMenuText" android:text="Sair" android:textColor="#C0392B" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>